<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.sokar</groupId>
        <artifactId>sokar-buildtools</artifactId>
        <version>0.4.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sokar-release</artifactId>
    <name>Sokar Release</name>
    <description>Sokar - Deciding what an agent package may publish without a person (BUILD)</description>

    <properties>
        <!-- Published: the three agent repositories call this from their own builds and update
             jobs, and three copies of it are what drifted apart. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <skipPublishing>false</skipPublishing>
    </properties>

    <dependencies>

        <!-- Not sokar-machines: that brings an SSH stack, and these commands run in every
             package build, offline ones included. -->

        <dependency>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-core-java</artifactId>
            <version>${cyclonedx-core-java.version}</version>
        </dependency>

        <dependency>
            <groupId>org.fuin.sokar</groupId>
            <artifactId>sokar-json</artifactId>
        </dependency>

        <!-- An agent definition is read by Sokar's own reader, never by a pattern over its text. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.fuin.sokar.release</Automatic-Module-Name>
                            <Main-Class>org.fuin.sokar.release.Main</Main-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
